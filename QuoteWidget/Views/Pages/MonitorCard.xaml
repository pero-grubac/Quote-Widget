<UserControl x:Class="QuoteWidget.Views.Pages.MonitorCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ui:CardExpander Margin="0,0,0,12" IsExpanded="True">
        <ui:CardExpander.Icon>
            <ui:SymbolIcon Symbol="Desktop24" />
        </ui:CardExpander.Icon>
        <ui:CardExpander.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TitleTextBlock" FontWeight="Bold" FontSize="14" />
                    <TextBlock x:Name="SubtitleTextBlock" Opacity="0.7" FontSize="12" />
                </StackPanel>

                <ui:ToggleSwitch Grid.Column="1" x:Name="EnabledToggle" OffContent="Disabled" OnContent="Enabled"
                                  Margin="0,0,12,0" Click="EnabledToggle_Click" />
            </Grid>
        </ui:CardExpander.Header>

        <StackPanel Margin="4,12,4,4">
            <ui:ToggleSwitch x:Name="UnlockToggle" OffContent="Locked (click-through)" OnContent="Unlocked (drag / resize)"
                              Margin="0,0,0,16" Click="UnlockToggle_Click" />

            <TextBlock Text="Quote font size" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" x:Name="QuoteFontSizeSlider" Minimum="10" Maximum="72" ValueChanged="QuoteFontSizeSlider_ValueChanged" />
                <TextBlock Grid.Column="1" x:Name="QuoteFontSizeValueText" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
            <Grid Margin="0,0,40,16">
                <TextBlock Text="10" HorizontalAlignment="Left" Opacity="0.6" FontSize="11" />
                <TextBlock Text="72" HorizontalAlignment="Right" Opacity="0.6" FontSize="11" />
            </Grid>

            <TextBlock Text="Details font size (movie / character) - independent of the quote size above" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" x:Name="DetailsFontSizeSlider" Minimum="10" Maximum="72" ValueChanged="DetailsFontSizeSlider_ValueChanged" />
                <TextBlock Grid.Column="1" x:Name="DetailsFontSizeValueText" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
            <Grid Margin="0,0,40,16">
                <TextBlock Text="10" HorizontalAlignment="Left" Opacity="0.6" FontSize="11" />
                <TextBlock Text="72" HorizontalAlignment="Right" Opacity="0.6" FontSize="11" />
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Text color" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="TextColorSwatch" Width="24" Height="20" BorderBrush="Gray" BorderThickness="1" Margin="0,0,8,0" />
                        <ui:Button Content="Choose..." Click="ChooseTextColor_Click" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Background color" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="BackgroundColorSwatch" Width="24" Height="20" BorderBrush="Gray" BorderThickness="1" Margin="0,0,8,0" />
                        <ui:Button Content="Choose..." Click="ChooseBackgroundColor_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <TextBlock Text="Background opacity" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" x:Name="OpacitySlider" Minimum="0" Maximum="100" ValueChanged="OpacitySlider_ValueChanged" />
                <TextBlock Grid.Column="1" x:Name="OpacityValueText" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>

            <TextBlock Text="Rotation interval (minutes)" Margin="0,0,0,4" />
            <ui:NumberBox x:Name="IntervalNumberBox" Minimum="1" Maximum="1440" Width="160" HorizontalAlignment="Left"
                          ClearButtonEnabled="False" Margin="0,0,0,16" ValueChanged="IntervalNumberBox_ValueChanged" />

            <TextBlock Text="Position and size (relative to this monitor)" FontWeight="Bold" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="X" />
                    <ui:NumberBox x:Name="XNumberBox" ClearButtonEnabled="False" ValueChanged="BoundsNumberBox_ValueChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Y" />
                    <ui:NumberBox x:Name="YNumberBox" ClearButtonEnabled="False" ValueChanged="BoundsNumberBox_ValueChanged" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Width" />
                    <ui:NumberBox x:Name="WidthNumberBox" Minimum="220" ClearButtonEnabled="False" ValueChanged="BoundsNumberBox_ValueChanged" />
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="Height" />
                    <ui:NumberBox x:Name="HeightNumberBox" Minimum="140" ClearButtonEnabled="False" ValueChanged="BoundsNumberBox_ValueChanged" />
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0" Content="Copy appearance to..." Click="CopyToOne_Click" />
                <ComboBox Grid.Column="2" x:Name="CopyTargetComboBox" DisplayMemberPath="DisplayName" />

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <ui:Button Content="Apply to all monitors" Margin="0,0,8,0" Click="ApplyToAll_Click" />
                    <ui:Button Content="Reset this monitor" Click="ResetThis_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ui:CardExpander>
</UserControl>
