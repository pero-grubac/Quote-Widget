<UserControl x:Class="QuoteWidget.Views.Pages.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel Margin="20" MaxWidth="520" HorizontalAlignment="Left">

        <ui:Card Margin="0,0,0,12">
            <ui:ToggleSwitch x:Name="AlwaysOnTopToggle" OffContent="Widgets stay below other windows"
                              OnContent="Widgets always stay on top" Click="AlwaysOnTopToggle_Click" />
        </ui:Card>

        <ui:Card Margin="0,0,0,12">
            <ui:ToggleSwitch x:Name="HideWhenFullscreenToggle" OffContent="Widgets stay visible over fullscreen apps"
                              OnContent="Widgets hide while a fullscreen app (game, video) is running"
                              Click="HideWhenFullscreenToggle_Click" />
        </ui:Card>

        <ui:Card Margin="0,0,0,12">
            <ui:ToggleSwitch x:Name="StartWithWindowsToggle" OffContent="Does not start with Windows"
                              OnContent="Starts with Windows" Click="StartWithWindowsToggle_Click" />
        </ui:Card>

    </StackPanel>
</UserControl>
